#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>

#define TFT_CS   5
#define TFT_DC   2
#define TFT_RST  4

Adafruit_ILI9341 tft = Adafruit_ILI9341(TFT_CS, TFT_DC, TFT_RST);

void setup() {
  tft.begin();
  tft.setRotation(3);

  tft.fillScreen(ILI9341_BLACK);

  // Title
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println("DIY SpeedCoach");

 // Distance
tft.setTextColor(ILI9341_CYAN);
tft.setTextSize(2);
tft.setCursor(10, 60);
tft.print("Distance:");

tft.setTextColor(ILI9341_WHITE);
tft.setTextSize(3);
tft.setCursor(140, 55);
tft.print("0");

tft.setTextSize(1);
tft.setCursor(180, 70);
tft.print("m");

  // Split
  tft.setTextColor(ILI9341_YELLOW);
  tft.setTextSize(2);
  tft.setCursor(10, 120);
  tft.print("Split:");

  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(3);
  tft.setCursor(120, 115);
  tft.print("0:00");

  tft.setTextSize(1);
  tft.setCursor(205, 130);
  tft.print("/500m");

  // Stroke Rate
tft.setTextColor(ILI9341_GREEN);
tft.setTextSize(2);
tft.setCursor(10, 180);
tft.print("SR:");

tft.setTextColor(ILI9341_WHITE);
tft.setTextSize(3);
tft.setCursor(140, 175);
tft.print("0");

tft.setTextSize(1);
tft.setCursor(180, 190);
tft.print("spm");
}

void loop() {
}
