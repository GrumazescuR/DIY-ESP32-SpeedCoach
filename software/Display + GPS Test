#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>
#include <TinyGPSPlus.h>

// TFT screen pins
#define TFT_CS   5
#define TFT_DC   2
#define TFT_RST  4

// GPS uses the ESP32's second serial port
#define GPS_RX 16
#define GPS_TX 17

// Create the screen, GPS and serial objects
Adafruit_ILI9341 tft = Adafruit_ILI9341(TFT_CS, TFT_DC, TFT_RST);
TinyGPSPlus gps;
HardwareSerial gpsSerial(2);

// Store the last valid GPS position
double lastLat = 0.0;
double lastLng = 0.0;

// Running distance travelled in metres
double totalDistance = 0.0;

// Used so the first GPS point becomes the starting point
bool havePreviousPosition = false;

void setup() {

  // Serial Monitor, useful for checking what the ESP32 is doing
  Serial.begin(115200);
  Serial.println("GPS test starting...");

  // Start communication with the L76K GPS
  // The GPS runs at 9600 baud by default
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX);

  // Start the TFT screen
  tft.begin();

  // Landscape orientation
  tft.setRotation(3);

  // Clear the screen
  tft.fillScreen(ILI9341_BLACK);

  // Main title
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println("DIY SpeedCoach");

  // Distance label
  tft.setTextColor(ILI9341_CYAN);
  tft.setTextSize(2);
  tft.setCursor(10, 60);
  tft.print("Distance:");

  // Starting distance value
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(3);
  tft.setCursor(140, 55);
  tft.print("0");

  tft.setTextSize(1);
  tft.setCursor(220, 70);
  tft.print("m");

  // Split label
  tft.setTextColor(ILI9341_YELLOW);
  tft.setTextSize(2);
  tft.setCursor(10, 120);
  tft.print("Split:");

  // Temporary split value for now
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(3);
  tft.setCursor(120, 115);
  tft.print("0:00");

  tft.setTextSize(1);
  tft.setCursor(205, 130);
  tft.print("/500m");

  // Stroke rate label
  tft.setTextColor(ILI9341_GREEN);
  tft.setTextSize(2);
  tft.setCursor(10, 180);
  tft.print("Stroke:");

  // Temporary stroke rate value
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(3);
  tft.setCursor(140, 175);
  tft.print("0");

  tft.setTextSize(1);
  tft.setCursor(180, 190);
  tft.print("spm");
}

void loop() {

  // Read any new data coming from the GPS
  while (gpsSerial.available()) {
    gps.encode(gpsSerial.read());
  }

  // Only work with a new valid GPS position
  if (gps.location.isUpdated() && gps.location.isValid()) {

    double currentLat = gps.location.lat();
    double currentLng = gps.location.lng();

    // The first valid point becomes our starting position
    if (!havePreviousPosition) {
      lastLat = currentLat;
      lastLng = currentLng;
      havePreviousPosition = true;
    }

    else {

      // Distance from the last position we accepted as real movement
      double movedDistance = TinyGPSPlus::distanceBetween(
        lastLat,
        lastLng,
        currentLat,
        currentLng
      );

      // Ignore small GPS drift and unrealistic large jumps
      if (movedDistance > 3.0 && movedDistance < 100.0) {

        totalDistance += movedDistance;

        // Only move our reference point after real movement is counted
        lastLat = currentLat;
        lastLng = currentLng;
      }
    }
  }

  // Clear the GPS status area before updating it
  tft.fillRect(200, 10, 115, 40, ILI9341_BLACK);

  tft.setTextSize(1);
  tft.setCursor(200, 10);

  // Show whether the GPS has a valid position
  if (gps.location.isValid()) {
    tft.setTextColor(ILI9341_GREEN);
    tft.print("GPS: FIXED");
  } else {
    tft.setTextColor(ILI9341_RED);
    tft.print("GPS: SEARCHING");
  }

  // Show satellite count
  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(200, 25);
  tft.print("Sat: ");
  tft.print(gps.satellites.value());

  // Clear the previous distance number
  tft.fillRect(140, 50, 150, 35, ILI9341_BLACK);

  // Display total distance travelled
  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(3);
  tft.setCursor(140, 55);
  tft.print((int)totalDistance);

  tft.setTextSize(1);
  tft.setCursor(220, 70);
  tft.print("m");

  delay(500);
}
